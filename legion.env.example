# Legion settings. Copy this file to /opt/legion/legion.env on the host, fill it in, then run ./setup.sh.
# systemd loads it with EnvironmentFile= and the shell scripts source it, so keep one KEY=value per line and put a value
# with spaces or shell characters in double quotes. Every key below shows its default; a line you delete keeps it.
# Secrets never go here: they are files in /opt/legion/secrets (docs/HOST.md).

# --- The repository ---------------------------------------------------------------------------------------------
# The repository every agent works on, as owner/name. Required.
LEGION_REPO=acme/shop
# The branch that is production: agents branch from it, open PRs against it, and read their rules from it.
LEGION_BASE_BRANCH=main
# The engineers whose words count, as org/team-slug. Empty: every collaborator with push access.
LEGION_TEAM=
# Who reviews a PR that an agent opens: GitHub logins, and team slugs of the repository's org.
LEGION_PR_REVIEWERS=
LEGION_PR_TEAM_REVIEWERS=
# No agent change may touch these path prefixes; a PR that does needs a person to approve it.
LEGION_GUARDED_PATHS=".github/,infra/,.claude/,.legion/"
# Folders whose children get a `<root>/<child>` label when the repository has that label, as `apps/web`.
LEGION_PACKAGE_ROOTS=
LEGION_LOCKFILES="pnpm-lock.yaml,package-lock.json,yarn.lock,go.sum,poetry.lock,uv.lock,Cargo.lock"
# What the repository's bug form puts before an issue title. A PR title drops it; Valac's issues start with it.
LEGION_ISSUE_TITLE_PREFIX="[bug] "
# Where Orobas reads the review rulebook on the base branch. Absent: the starter rulebook in orobas/rules/.
LEGION_RULES_DIR=.legion/rules
# The files that tell an agent how a folder works, read from the root down to each touched folder.
LEGION_GUIDE_FILES="AGENTS.md,CLAUDE.md"

# Run as a GitHub App instead of a bot account: the App id, the installation id on this repository, and the private key
# in secrets/github_app_key.pem. Set, the hosts mint their own tokens and the sandboxes get read-only ones per run, so
# github_host_token and github_sandbox_token are not needed. Empty: the two token files are used.
LEGION_GITHUB_APP_ID=
LEGION_GITHUB_APP_INSTALLATION_ID=

# --- The sandbox ------------------------------------------------------------------------------------------------
# The Claude Code CLI version in the sandbox image. Empty: the version shared/sandbox/Dockerfile pins.
LEGION_CLAUDE_CODE_VERSION=
# How a fresh clone installs its dependencies. Empty: the repository needs no install.
LEGION_INSTALL_CMD="pnpm install --frozen-lockfile --reporter=silent"
# The commands an agent may run besides git, search and jq, as Claude Code permission rules.
LEGION_SANDBOX_ALLOW="Bash(pnpm:*),Bash(npm:*),Bash(npx:*)"
# The hosts the sandbox may reach besides GitHub, Anthropic and Axiom: the package registries, mostly.
LEGION_PROXY_HOSTS=registry.npmjs.org
# Extra Debian packages for the sandbox image, and a Dockerfile that builds on it (FROM legion-sandbox:local).
LEGION_SANDBOX_APT=
LEGION_SANDBOX_DOCKERFILE=
# The boot check: a run refuses to start when any environment variable matches this regex. Name your production keys.
LEGION_BOOT_DENY="sk_live_|STRIPE_SECRET|AWS_SECRET_ACCESS_KEY|DATABASE_URL"
# The models: the deep one plans, fixes and reviews; the fast one triages and writes.
LEGION_MODEL=claude-opus-5-5
LEGION_FAST_MODEL=claude-sonnet-5-5

# --- Telemetry --------------------------------------------------------------------------------------------------
# The Axiom dataset of the agents' own run log (secrets/axiom_ingest_token). No token: the log stays local.
LEGION_LOG_DATASET=legion
LEGION_ENVIRONMENT=production
# The production datasets the agents may query (secrets/axiom_token, read-only), comma separated.
LEGION_LOG_DATASETS=
# PostHog, read-only (secrets/posthog_key). No project id: the agents never query it.
LEGION_POSTHOG_PROJECT_ID=
LEGION_POSTHOG_HOST=us.posthog.com

# --- Slack and the deploy ---------------------------------------------------------------------------------------
# Who a hand-off pings, as <!subteam^S0123> or <@U0123>. Empty pings nobody.
LEGION_ONCALL_MENTION=
# The file on the base branch that maps a GitHub login to a Slack user id: {"octocat": "U0123"}.
LEGION_SLACK_USER_MAP=.github/slack-user-map.json
# The GitHub deployment environments that count as production. Empty: a green merge is the end, no deploy watch.
LEGION_DEPLOY_ENVIRONMENT=production

# --- The host ---------------------------------------------------------------------------------------------------
# The agents this VM runs, comma separated. Empty: every agent folder.
LEGION_AGENTS=
# The public name of a VM that shared/host/setup.sh prepares (Docker, Caddy, the Caddyfile). Empty: skip that step.
LEGION_HOSTNAME=
# An Azure Key Vault that holds the secret files, read with the VM's managed identity. Empty: write the files by hand.
LEGION_KEY_VAULT=
# Where the hooks service listens behind the reverse proxy.
LEGION_HOOKS_HOST=127.0.0.1
LEGION_HOOKS_PORT=8645

# --- Marbas: bug thread to PR -----------------------------------------------------------------------------------
# The Slack channel ids Marbas watches. Required for Marbas.
MARBAS_CHANNELS=
# The Slack user ids that may start a thread, as the bot that posts new bug reports. Empty: any engineer.
MARBAS_TRIGGER_USERS=
# Channels where an engineer may start a thread by hand even when MARBAS_TRIGGER_USERS is set.
MARBAS_TEST_CHANNELS=
# When set, the thread parent must hold this text and come from the same poster, as "New bug report:".
MARBAS_TRIGGER_TEXT=
# A channel id runs every bug in a mirror thread there, and the real thread gets nothing. Empty: live.
MARBAS_SHADOW_CHANNEL=
# The kill switch: false stops new bug threads; open PRs keep their deploy watch and proof.
MARBAS_ENABLED=true
# true: Marbas merges after an engineer approves the last commit and CI is green. false: a person merges.
MARBAS_AUTO_MERGE=false
# true: a plan Reject asks what to change and plans again. false: the engineer who rejects takes the bug.
MARBAS_REPLAN_ON_REJECT=false
# true: an engineer's "Request changes" starts a run that applies it, up to three rounds. false: a person takes it.
MARBAS_ADDRESS_REVIEW=false
MARBAS_DEPLOY_TIMEOUT_SECONDS=5400
MARBAS_NO_DEPLOY_TIMEOUT_SECONDS=1200
MARBAS_WALL_SECONDS=2700
MARBAS_MAX_TURNS=200
MARBAS_MEMORY=6g
MARBAS_CPUS=3

# --- Valac: log patrol to issue to PR ---------------------------------------------------------------------------
# The kill switch. Off by default: turn it on once LEGION_LOG_DATASETS is set.
VALAC_ENABLED=false
# false: issues only, and the team closes the wrong ones. true: it also opens the PR for each issue.
VALAC_CAN_OPEN_PR=false
# A systemd calendar for the patrol.
VALAC_SCHEDULE="Mon..Fri *-*-* 07:00:00 UTC"
# How many hours of logs one patrol reads, and how many days of git history it gets to tell old from new.
VALAC_WINDOW_HOURS=24
VALAC_HISTORY_DAYS=45
# At most this many Valac issues and PRs wait for people at once; a finding below the score floor is dropped.
VALAC_MAX_ACTIVE=3
VALAC_MIN_SCORE=40
# A finding closed as wrong sleeps this long before it may come back.
VALAC_SNOOZE_DAYS=30
VALAC_WALL_SECONDS=2700
VALAC_MAX_TURNS=200
VALAC_PATROL_MEMORY=2g
VALAC_FIX_MEMORY=6g
VALAC_CPUS=2

# --- Orobas: PR review ------------------------------------------------------------------------------------------
# The kill switch: false stops new reviews.
OROBAS_ENABLED=true
# false: COMMENT where the bot would APPROVE, and it asks the team. Turn it on once the team trusts it.
OROBAS_CAN_APPROVE=false
# false: COMMENT where the bot would REQUEST_CHANGES. The rules in OROBAS_ALWAYS_BLOCK still block.
OROBAS_CAN_BLOCK=false
OROBAS_ALWAYS_BLOCK=STD-01
# STD-01: a PR must link an issue, unless it has the `no-issue` label.
OROBAS_REQUIRE_ISSUE=true
# STD-02: the branch prefixes and the title types, and whether a title needs a (scope).
OROBAS_BRANCH_TYPES="feat,fix,chore,docs,refactor,test,perf,ci,build"
OROBAS_TITLE_NEEDS_SCOPE=false
# STD-03: bases a PR may target besides LEGION_BASE_BRANCH, and long-lived branches a PR must not merge in.
OROBAS_EXTRA_BASES=
OROBAS_FORBIDDEN_MERGES=
# STD-05: an AI attribution line in a body or a commit is a finding.
OROBAS_FORBID_ATTRIBUTION=true
OROBAS_MAX_LANES=4
# Full reviews a UTC day, oldest PR first. The light check after a push does not count.
OROBAS_DAILY_FULL_REVIEWS=50
# The equivalent USD one Claude seat window holds before it answers 429, and the share Orobas may spend of it.
OROBAS_SEAT_WINDOW_USD=160
OROBAS_SEAT_SHARE=0.35
OROBAS_MEMORY=3g
OROBAS_CPUS=2
